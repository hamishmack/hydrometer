cabal-version:      3.4
name:               hydrometer-server
version:            0.1.0.0
synopsis:           Collector, store and API server for hydrometer
license:            Apache-2.0
license-file:       LICENSE
author:             Hamish Mackenzie
maintainer:         Hamish.K.Mackenzie@gmail.com
category:           System
build-type:         Simple
extra-source-files: sql/*.sql

common warnings
  ghc-options:        -Wall
  default-language:   GHC2021
  default-extensions: LambdaCase OverloadedStrings DerivingStrategies

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Hydrometer.Server.Blockers
                    Hydrometer.Server.CacheHealth
                    Hydrometer.Server.Config
                    Hydrometer.Server.Db
                    Hydrometer.Server.Drv
                    Hydrometer.Server.GcLock
                    Hydrometer.Server.Http
                    Hydrometer.Server.Ingest
                    Hydrometer.Server.Logs
                    Hydrometer.Server.Main
                    Hydrometer.Server.Maintain
                    Hydrometer.Server.Mcp
                    Hydrometer.Server.Now
                    Hydrometer.Server.Queries
                    Hydrometer.Server.QueueRunner
                    Hydrometer.Server.StepGraph
                    Hydrometer.Server.EvalProgress
                    Hydrometer.Server.Substitutions
  build-depends:    base >=4.18 && <5
                  , file-embed
                  , postgresql-libpq
                  , scientific
                  , aeson >=2.1
                  , async
                  , bytestring
                  , containers
                  , directory
                  , filepath
                  , http-client
                  , http-client-tls
                  , http-types
                  , network
                  , postgresql-simple
                  , process
                  , stm
                  , text
                    , unix
                  , time
                  , vector
                  , wai
                  , warp
                  , hydrometer-core

executable hydrometer
  import:           warnings
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base, hydrometer-server
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N4 -A16m"
