cabal-version:      3.4
name:               hydrometer-core
version:            0.1.0.0
synopsis:           Shared types for hydrometer (agent wire protocol and API)
license:            Apache-2.0
license-file:       LICENSE
author:             Hamish Mackenzie
maintainer:         Hamish.K.Mackenzie@gmail.com
category:           System
build-type:         Simple

library
  hs-source-dirs:   src
  exposed-modules:  Hydrometer.Types
                    Hydrometer.Api
  build-depends:    base >=4.18 && <5
                  , aeson >=2.1
                  , containers
                  , text
  ghc-options:      -Wall
  default-language: GHC2021
  default-extensions: LambdaCase OverloadedStrings DerivingStrategies
